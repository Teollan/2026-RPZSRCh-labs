{
  "name": "RPZSRCh lab1 (ROS 2 Lyrical)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/lab1,type=bind",
  "workspaceFolder": "/lab1",
  "runArgs": [
    "--network=host"
  ],
  "remoteUser": "root",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ranch-hand-robotics.rde-pack",
        "twxs.cmake"
      ],
      "settings": {
        "C_Cpp.default.includePath": [
          "/opt/ros/lyrical/include/**",
          "/lab1/ros2_ws/install/**/include/**",
          "${workspaceFolder}/ros2_ws/src/**"
        ],
        "C_Cpp.default.compileCommands": "/lab1/ros2_ws/build/compile_commands.json",
        "C_Cpp.default.cppStandard": "gnu++20",
        "C_Cpp.default.cStandard": "gnu17",
        "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
